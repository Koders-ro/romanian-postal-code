# Required: clients must send this key (X-API-Key header, Bearer token or ?api_key=).
# Several keys can be given separated by commas, to rotate keys without downtime.
API_KEY=change-me

# Optional
PORT=8080
MAX_BATCH=500
# Requests per minute per client IP on /v1/* (0 = off)
RATE_LIMIT=0
# Set to true when running behind a reverse proxy (Coolify/Traefik, nginx, Cloudflare...)
# so rate limits and logs use the real client IP from X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
